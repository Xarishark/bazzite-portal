#: bazzite_portal/core/errors.py:65
#, python-brace-format
msgid ""
"Not enough free space. Free up space and try again. System updates need at "
"least {minimum_free_space} free space on the installation drive."
msgstr ""
"Spazio libero insufficiente. Libera spazio e riprova. Gli aggiornamenti di "
"sistema richiedono almeno {minimum_free_space} di spazio libero nell'unità "
"di installazione."

#: bazzite_portal/core/errors.py:68
msgid ""
"The download's signature could not be verified. Try again later. If the "
"problem continues, open Logs for details."
msgstr ""
"Non è stato possibile verificare la firma del download. Riprova più tardi. "
"Se il problema persiste, apri i log per maggiori dettagli."

#: bazzite_portal/core/errors.py:70
msgid ""
"A downloaded file failed checksum verification. Try again later and check "
"the operation log if the problem continues."
msgstr ""
"La verifica del checksum di un file scaricato non è riuscita. Riprova più "
"tardi e, se il problema persiste, consulta i log delle operazioni."

#: bazzite_portal/core/errors.py:72
msgid ""
"A package conflict is blocking this system change. Review your layered apps "
"in System Management, then try again."
msgstr ""
"Un conflitto tra pacchetti impedisce questa modifica al sistema. Controlla "
"le applicazioni installate tramite layering in Gestione del sistema, quindi "
"riprova."

#: bazzite_portal/core/errors.py:74
msgid "The download server is busy. Wait a little and try again."
msgstr "Il server di download è occupato. Riprova più tardi."

#: bazzite_portal/core/errors.py:76
msgid ""
"Could not connect to the download server. Check your connection and try "
"again."
msgstr ""
"Impossibile connettersi al server di download. Controlla la connessione a "
"Internet e riprova."

#: bazzite_portal/core/errors.py:78
msgid ""
"Could not download software repository information. Try again later. If this "
"continues, check your repository settings or open Logs."
msgstr ""
"Impossibile scaricare le informazioni sul repository del software. Riprova "
"più tardi. Se il problema persiste, controlla le impostazioni del repository "
"oppure apri log."

