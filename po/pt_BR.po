#: bazzite_portal/core/errors.py:65
#, python-brace-format
msgid ""
"Not enough free space. Free up space and try again. System updates need at "
"least {minimum_free_space} free space on the installation drive."
msgstr ""
"Armazenamento insuficiente. Libere espaço e tente novamente. Atualizações do "
"sistema precisam de pelo menos {minimum_free_space} livres em seu "
"dispositivo."

#: bazzite_portal/core/errors.py:68
msgid ""
"The download's signature could not be verified. Try again later. If the "
"problem continues, open Logs for details."
msgstr ""
"A assinatura do download não pôde ser autenticada. Tente novamente mais "
"tarde. Se o problema persistir, verifique seus registros do sistema."

#: bazzite_portal/core/errors.py:70
msgid ""
"A downloaded file failed checksum verification. Try again later and check "
"the operation log if the problem continues."
msgstr ""
"Um arquivo baixado falhou na verificação de integridade. Tente novamente "
"mais tarde; e se o problema persistir, verifique os registros do processo."

#: bazzite_portal/core/errors.py:72
msgid ""
"A package conflict is blocking this system change. Review your layered apps "
"in System Management, then try again."
msgstr ""
"Um conflito de pacotes impossibilita esta transação. Verifique seus pacotes "
"sobrepostos na Administração do Sistema, e tente novamente."

#: bazzite_portal/core/errors.py:74
msgid "The download server is busy. Wait a little and try again."
msgstr ""
"O servidor de download está ocupado. Aguarde alguns momentos e tente "
"novamente."

#: bazzite_portal/core/errors.py:76
msgid ""
"Could not connect to the download server. Check your connection and try "
"again."
msgstr ""
"Não foi possível se conectar ao servidor de download. Verifique sua conexão "
"e tente novamente."

#: bazzite_portal/core/errors.py:78
msgid ""
"Could not download software repository information. Try again later. If this "
"continues, check your repository settings or open Logs."
msgstr ""
"Não foi possível obter os metadados do repositório. Tente novamente mais "
"tarde. Se o problema persistir, verifique a configuração do repositório, ou "
"verifique seus registros do sistema."

