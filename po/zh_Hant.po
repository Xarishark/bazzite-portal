#: bazzite_portal/core/errors.py:65
#, python-brace-format
msgid ""
"Not enough free space. Free up space and try again. System updates need at "
"least {minimum_free_space} free space on the installation drive."
msgstr ""
"儲存空間不足，請清理空間後再試。進行系統更新需額外{minimum_free_space}的儲存"
"空間。"

#: bazzite_portal/core/errors.py:68
msgid ""
"The download's signature could not be verified. Try again later. If the "
"problem continues, open Logs for details."
msgstr "無法驗證已下載檔案的簽名，請稍後再試。若問題持續，請查看系統日誌。"

#: bazzite_portal/core/errors.py:70
msgid ""
"A downloaded file failed checksum verification. Try again later and check "
"the operation log if the problem continues."
msgstr ""
"有已下載的檔案在驗證時出現錯誤，請稍後再試。若問題持續，請查看運行日誌。"

#: bazzite_portal/core/errors.py:72
msgid ""
"A package conflict is blocking this system change. Review your layered apps "
"in System Management, then try again."
msgstr ""
"由於軟件包出現衝突，此系統變更操作被阻止。請於系統管理頁面中檢查疊加套件後再"
"試。"

#: bazzite_portal/core/errors.py:74
msgid "The download server is busy. Wait a little and try again."
msgstr "伺服器當前較繁忙，請稍後再試。"

#: bazzite_portal/core/errors.py:76
msgid ""
"Could not connect to the download server. Check your connection and try "
"again."
msgstr "無法連線至伺服器，請檢查你的連線狀態之後再試一次。"

#: bazzite_portal/core/errors.py:78
msgid ""
"Could not download software repository information. Try again later. If this "
"continues, check your repository settings or open Logs."
msgstr ""
"無法下載軟件倉資訊，請稍後再試。若問題持續，請查看軟件倉設置或系統日誌。"

#: bazzite_portal/core/errors.py:121 bazzite_portal/ui/application.py:2230
