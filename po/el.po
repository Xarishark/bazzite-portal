#: bazzite_portal/maintenance/image_switch.py:118
#, python-brace-format
msgid "Only supported official {bazzite} image references can be changed."
msgstr ""
"Επιτρέπεται η μετάβαση μόνο σε υποστηριζόμενες επίσημες εικόνες συστήματος "
"του {bazzite}."

#: bazzite_portal/maintenance/image_switch.py:166
#, python-brace-format
