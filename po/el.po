#: bazzite_portal/maintenance/image_switch.py:110
msgid "Resolve the pending deployment before changing images."
msgstr ""
"Ολοκληρώστε ή ακυρώστε την εκκρεμή αλλαγή έκδοσης του συστήματος πριν "
"αλλάξετε εικόνα συστήματος."

#: bazzite_portal/maintenance/image_switch.py:117
msgid "Only supported official Bazzite image references can be changed."
msgstr ""
"Μπορούν να αλλαχθούν μόνο οι υποστηριζόμενες επίσημες εικόνες συστήματος του "
"Bazzite."

#: bazzite_portal/maintenance/image_switch.py:165
msgid "No official Bazzite images are available."
msgstr "Δεν υπάρχουν διαθέσιμες επίσημες εικόνες συστήματος του Bazzite."

#: bazzite_portal/maintenance/image_switch.py:186
#, python-brace-format
msgid "No {track} versions are available for {image}."
msgstr ""
"Δεν υπάρχουν διαθέσιμες εκδόσεις {track} για την εικόνα συστήματος {image}."

#: bazzite_portal/maintenance/image_switch.py:206
msgid "Unsupported Bazzite image variant."
msgstr "Μη υποστηριζόμενη παραλλαγή εικόνας συστήματος του Bazzite."

#: bazzite_portal/maintenance/image_switch.py:208
msgid "Unsupported Bazzite image version."
msgstr "Μη υποστηριζόμενη έκδοση εικόνας συστήματος του Bazzite."

#: bazzite_portal/maintenance/image_switch.py:221
msgid ""
"This image and version are already running. Use Update to check for a newer "
"version."
msgstr ""
"Αυτή η εικόνα και έκδοση του συστήματος χρησιμοποιούνται ήδη. Χρησιμοποιήστε "
"την Ενημέρωση για να ελέγξετε αν υπάρχει νεότερη έκδοση."

#: bazzite_portal/maintenance/logs.py:147
msgid "Some operation output was unavailable or omitted."
msgstr "Μέρος της εξόδου της διαδικασίας δεν ήταν διαθέσιμο ή παραλείφθηκε."

#: bazzite_portal/maintenance/reset_layers.py:46
#: bazzite_portal/ui/application.py:3791
msgid "A different deployment is selected for next boot."
msgstr ""
"Έχει επιλεγεί διαφορετική έκδοση του συστήματος για την επόμενη εκκίνηση."

#: bazzite_portal/maintenance/reset_layers.py:88
#: bazzite_portal/ui/application.py:3790
msgid "No requested package layers are present."
msgstr "Δεν υπάρχουν πακέτα που έχουν ζητηθεί για εγκατάσταση μέσω layering."

#: bazzite_portal/maintenance/reset_layers.py:218
msgid "Requested package layers removed."
msgstr "Τα πακέτα που είχαν ζητηθεί για αφαίρεση μέσω layering αφαιρέθηκαν."

