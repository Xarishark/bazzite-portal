msgstr ""
"Η ακύρωση της εκκρεμούς έκδοσης του συστήματος βρίσκεται ήδη σε εξέλιξη."

#: bazzite_portal/updates/monitor.py:1834
msgid "Package-layer removal is already running."
msgstr "Η αφαίρεση πακέτων μέσω layering βρίσκεται ήδη σε εξέλιξη."

#: bazzite_portal/updates/monitor.py:1836
#: bazzite_portal/updates/monitor.py:1866
#: bazzite_portal/updates/monitor.py:1895
msgid "Download-cache cleanup is already running."
msgstr "Η εκκαθάριση της προσωρινής μνήμης λήψεων βρίσκεται ήδη σε εξέλιξη."

#: bazzite_portal/updates/monitor.py:1842
msgid "Pending-deployment cancellation completed."
msgstr "Η ακύρωση της εκκρεμούς έκδοσης του συστήματος ολοκληρώθηκε."

#: bazzite_portal/updates/monitor.py:1860
#: bazzite_portal/updates/monitor.py:1887
msgid "The requested package list changed after confirmation."
msgstr "Η λίστα των ζητούμενων πακέτων άλλαξε μετά την επιβεβαίωση."

#: bazzite_portal/updates/monitor.py:1864
#: bazzite_portal/updates/monitor.py:1893
msgid "A package-layer or pending-deployment operation is already running."
msgstr ""
"Μια διαδικασία διαχείρισης πακέτων σε επίπεδα (layering) ή εκκρεμούς έκδοσης "
