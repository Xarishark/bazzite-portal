#: bazzite_portal/updates/monitor.py:1918
#: bazzite_portal/updates/monitor.py:1955
#: bazzite_portal/updates/monitor.py:1987
msgid "Another maintenance operation is already running."
msgstr "Μια άλλη διαδικασία συντήρησης βρίσκεται ήδη σε εξέλιξη."

#: bazzite_portal/updates/monitor.py:1923
msgid ""
"Download-cache cleanup completed. OSTree may retain shared objects used by "
