#: bazzite_portal/updates/monitor.py:2006
msgid "Another maintenance operation is running."
msgstr "Μια άλλη διαδικασία συντήρησης βρίσκεται σε εξέλιξη."

#: bazzite_portal/services/agent.py:464
msgid "Another operation request is pending."
msgstr "Εκκρεμεί ένα άλλο αίτημα εκτέλεσης διαδικασίας."

#: bazzite_portal/updates/monitor.py:1331
msgid "Another system operation is running or its state could not be verified."
msgstr ""
"Μια άλλη διαδικασία συστήματος βρίσκεται σε εξέλιξη ή δεν ήταν δυνατή η "
"επαλήθευση της κατάστασής της."

#: bazzite_portal/core/errors.py:51 bazzite_portal/updates/monitor.py:1772
