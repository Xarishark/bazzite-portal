#: bazzite_portal/maintenance/cache_clear.py:67
#, python-brace-format
msgid "An {rpm_ostree} transaction is active or status is unavailable."
msgstr ""
"Μια διαδικασία {rpm_ostree} βρίσκεται σε εξέλιξη ή η κατάστασή της δεν είναι "
"διαθέσιμη."

#: bazzite_portal/maintenance/cache_clear.py:74
#: bazzite_portal/maintenance/cache_clear.py:77
msgid "Cancel the pending deployment before clearing the download cache."
msgstr ""
"Ακυρώστε την εκκρεμή έκδοση του συστήματος πριν προχωρήσετε στην εκκαθάριση "
"της προσωρινής μνήμης λήψεων."

#: bazzite_portal/maintenance/cache_clear.py:75
msgid ""
"Resolve the selected next-boot deployment before clearing the download cache."
msgstr ""
"Ολοκληρώστε ή ακυρώστε την επιλεγμένη αλλαγή έκδοσης για την επόμενη "
"εκκίνηση πριν εκκαθαρίσετε την προσωρινή μνήμη λήψεων."

#: bazzite_portal/maintenance/cancel_pending.py:81
#, python-brace-format
msgid "{bootc} deployments cannot be canceled by this workflow."
msgstr ""
"Οι εκδόσεις συστήματος του {bootc} δεν μπορούν να ακυρωθούν μέσω αυτής της "
"διαδικασίας."

#: bazzite_portal/maintenance/cancel_pending.py:91
