[Desktop Entry]
Name=Bazzite Portal
Comment=Manage {bazzite} tools and system updates
Exec=bazzite-portal
Icon=io.github.Xarishark.bazzite_portal
Terminal=false
Type=Application
Categories=System;Settings;
Keywords=setup;configuration;updates;
StartupNotify=true
StartupWMClass=io.github.Xarishark.bazzite_portal
DBusActivatable=true
Actions=Updates;

[Desktop Action Updates]
Name=Updates
Exec=bazzite-portal --updates
